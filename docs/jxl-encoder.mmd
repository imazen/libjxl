    style OUTPUT fill:#49a,stroke:#27a,color:#fff
    style VARDCT_ENTRY fill:#e95,stroke:#c73,color:#fff
    style MODULAR_ENTRY fill:#59e,stroke:#37c,color:#fff
    style VARDCT_TOKENS fill:#e95,stroke:#c73,color:#fff
    style MODULAR_TOKENS fill:#59e,stroke:#37c,color:#fff
